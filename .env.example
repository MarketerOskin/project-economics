# ─── Core ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string. In Docker Compose this is set for you.
DATABASE_URL="postgresql://economics:economics@localhost:5432/economics?schema=public"

# Public URL the app is served from (used for OAuth redirects and CRM links).
APP_URL="http://localhost:3000"

NODE_ENV="development"

# ─── Security ────────────────────────────────────────────────────────────────
# Signs the session cookie (jose HS256). Generate: openssl rand -base64 48
SESSION_SECRET=""

# Encrypts Bitrix24 OAuth tokens at rest (AES-256-GCM). MUST be 32 bytes base64.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# ─── Bitrix24 application (local app) ────────────────────────────────────────
B24_CLIENT_ID=""
B24_CLIENT_SECRET=""

# ─── Portal allowlist (anti-unauthorized-deployment) ─────────────────────────
# When set, ONLY these Bitrix24 portals may install / open the app — an unknown
# portal is refused at install and at the placement handler. Comma-separated.
# Leave both empty to disable the allowlist (local dev, demo). The demo portal
# is always allowed regardless.
#   ALLOWED_PORTAL_MEMBER_IDS="a1b2c3d4e5f6...,9f8e7d6c..."
#   ALLOWED_PORTAL_DOMAINS="client.bitrix24.ru,client.bitrix24.com"
ALLOWED_PORTAL_MEMBER_IDS=""
ALLOWED_PORTAL_DOMAINS=""

# ─── Demo mode ───────────────────────────────────────────────────────────────
# When "true": the app runs without Bitrix24, seeds a demo portal, and exposes
# a role switcher (Администратор / Руководитель / Сотрудник). MUST be "false"
# for a real Bitrix24 installation.
DEMO_MODE="true"

# ─── Tests ───────────────────────────────────────────────────────────────────
# Separate database for the integration test suite (docker-compose.test.yml).
TEST_DATABASE_URL="postgresql://economics:economics@localhost:5433/economics_test?schema=public"
