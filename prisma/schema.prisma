// «Экономика проектов» — data model.
// PostgreSQL is the financial system of record. Bitrix24 is identity + CRM reference only.
// Money: Decimal(18,2). Hours / rate: Decimal(10,2). Dates that are calendar dates use @db.Date.
// Everything portal-owned carries portalId and is scoped by it in every query (withPortal).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AppRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectSource {
  MANUAL
  BITRIX_CRM
  /// Imported from Bitrix24's native "Проекты" module (sonet_group, PROJECT=Y) — a different
  /// REST domain from crm.item.* and with no entityTypeId concept, so it's a separate source
  /// kind rather than another CrmEntityType (ADR-031). Snapshot fields reuse crmEntityId/
  /// crmEntityTitle/crmEntityUrl generically; crmEntityType/crmEntityTypeId stay null.
  BITRIX_PROJECT
}

enum CrmEntityType {
  DEAL
  COMPANY
  SMART_PROCESS
}

enum FinanceDirection {
  INCOME
  EXPENSE
}

enum BudgetType {
  PLAN
  FACT
}

enum CalculationMode {
  FIXED
  HOURS_RATE
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum AuditAction {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  PROJECT_DELETED
  FINANCE_CREATED
  FINANCE_UPDATED
  FINANCE_DELETED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_ARCHIVED
  USER_ROLE_CHANGED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
}

enum AuditEntityType {
  PROJECT
  FINANCIAL_ENTRY
  CATEGORY
  USER
  PROJECT_MEMBER
  MARKETING_SPEND
  MARKETING_PLAN
  PROJECT_STREAM
}

// ─── Billing / plan ────────────────────────────────────────────────────────

/// FREE = default on install. PRO = paid features unlocked, granted by the operator
/// (manual billing for now — no automated payment processor is wired up yet).
enum Plan {
  FREE
  PRO
}

enum LeadKind {
  PRO
  IMPLEMENTATION
  /// «Интеграция с 1С» from the finance section (ADR-050).
  INTEGRATION_1C
}

enum ProLeadStatus {
  /// Just submitted, nobody has followed up yet.
  NEW
  /// The operator reached out.
  CONTACTED
  /// Became a paying (PRO) portal.
  CONVERTED
  /// Chose not to buy / went cold.
  DECLINED
}

// ─── Portal ──────────────────────────────────────────────────────────────────

model PortalInstallation {
  id       String  @id @default(cuid())
  /// Bitrix24 member_id — stable per portal. Demo portal uses "demo".
  memberId String  @unique
  domain   String
  /// Bitrix "application_token" for verifying inbound event/placement calls.
  applicationToken String?
  /// OAuth tokens, AES-256-GCM encrypted at rest. Never logged, never sent to the client.
  authTokenEnc     String?
  refreshTokenEnc  String?
  tokenExpiresAt   DateTime?
  /// REST endpoint reported by Bitrix at install time (client_endpoint).
  restEndpoint     String?
  isDemo    Boolean  @default(false)
  isActive  Boolean  @default(true)
  installedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Manual billing (ТЗ: operator-granted access ahead of Marketplace payment integration).
  plan          Plan      @default(FREE)
  /// Null = no expiry (granted indefinitely). Past this date the portal reverts to FREE.
  planExpiresAt DateTime?
  /// Free-text note from the operator (e.g. "оплатил на год, перевод от 12.03").
  planNote      String?

  /// Set once an ADMIN/MANAGER dismisses the dashboard onboarding checklist. Null = still
  /// showing (unless every step is already complete, in which case it auto-hides anyway).
  onboardingDismissedAt DateTime?

  /// Last full employee-list pull from Bitrix24 (`user.get`). Kept on the portal, not taken
  /// from AppUser.lastSyncedAt: signing in refreshes that for one user, which used to make
  /// the whole list look fresh so it was never pulled.
  usersSyncedAt DateTime?

  /// Set when an admin finishes «Настройка под портал» (ADR-041).
  setupCompletedAt DateTime?
  /// App sections this portal switched off (keys from src/lib/sections.ts); hidden from the menu.
  disabledSections String[] @default([])

  users      AppUser[]
  projects   Project[]
  categories FinanceCategory[]
  entries    FinancialEntry[]
  members    ProjectMember[]
  auditLogs  AuditLog[]
  planGrants OperatorGrant[]
  proLeads   ProLead[]
  apiLogs    ApiCallLog[]
  crmImportSources CrmImportSource[]
  crmTimeFields    CrmTimeField[]
  crmSectionRoles  CrmSectionRole[]
  crmStageRules    CrmStageRule[]
  projectStreams   ProjectStream[]
  taskTimeDrafts   TaskTimeDraft[]
  crmIncomeDrafts  CrmIncomeDraft[]
  supportPostings  SupportPosting[]
  marketingSpends  MarketingSpend[]
  marketingPlans   MarketingPlan[]
  marketingConfig  MarketingConfig?
  salesFunnelSnapshots SalesFunnelSnapshot[]
}

/// A "I want PRO" request submitted from the app's /pricing page. Manual sales funnel:
/// shows up in /operator for the operator to follow up and grant the plan.
model ProLead {
  id       String @id @default(cuid())
  portalId String
  portal   PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)

  requestedById   String?
  requestedBy     AppUser? @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  /// Snapshot of the requester's display name at submission time.
  requestedByName String
  /// Free-text contact the requester left (email / phone / Telegram) — not Bitrix24 identity.
  contact String
  comment String?
  /// PRO = "I want Pro" from /pricing; IMPLEMENTATION = "set the app up for how we work" (ADR-038).
  kind    LeadKind @default(PRO)

  status          ProLeadStatus @default(NEW)
  createdAt       DateTime      @default(now())
  handledAt       DateTime?
  /// Which operator last changed the status.
  handledByOperator String?

  @@index([portalId])
  @@index([status])
}

// ─── Operator (you — the app owner, outside every portal's role system) ─────

/// A grant/revoke of a plan by the app operator. Separate from AuditLog (which is
/// per-portal, actor = AppUser) because the operator is not a portal user at all.
model OperatorGrant {
  id           String   @id @default(cuid())
  portalId     String
  portal       PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  operatorEmail String
  plan         Plan
  expiresAt    DateTime?
  note         String?
  createdAt    DateTime @default(now())

  @@index([portalId])
}

// ─── Users (snapshot of Bitrix24 employees) ──────────────────────────────────

model AppUser {
  id           String  @id @default(cuid())
  portalId     String
  portal       PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  /// Bitrix24 user id (string form). Demo users use synthetic ids.
  bitrixUserId String
  firstName    String
  lastName     String
  photoUrl     String?
  position     String?
  isActive     Boolean @default(true)
  /// True when the user is a Bitrix24 portal administrator -> resolved as ADMIN.
  isBitrixAdmin Boolean @default(false)
  /// Application role. ADMIN may change MANAGER/EMPLOYEE; ADMIN itself follows isBitrixAdmin
  /// or an explicit grant.
  role         AppRole @default(EMPLOYEE)
  /// Часовая ставка для автоматического расчёта расхода из отработанных часов (ADR-027).
  /// NULL = ставка не задана — черновики по этому сотруднику видны, но не подтверждаемы.
  hourlyRate   Decimal? @db.Decimal(10, 2)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     ProjectMember[]  @relation("MemberUser")
  membersAdded    ProjectMember[]  @relation("MemberAddedBy")
  projectsCreated Project[]        @relation("ProjectCreatedBy")
  projectsUpdated Project[]        @relation("ProjectUpdatedBy")
  projectsArchived Project[]       @relation("ProjectArchivedBy")
  entriesAuthored FinancialEntry[] @relation("EntryCreatedBy")
  entriesUpdated  FinancialEntry[] @relation("EntryUpdatedBy")
  entriesDeleted  FinancialEntry[] @relation("EntryDeletedBy")
  entriesAssigned FinancialEntry[] @relation("EntryEmployee")
  auditLogs       AuditLog[]       @relation("AuditActor")
  proLeads        ProLead[]
  timeDrafts      TaskTimeDraft[]  @relation("TimeDraftEmployee")
  timeDraftsResolved TaskTimeDraft[] @relation("TimeDraftResolvedBy")
  incomeDraftsResolved CrmIncomeDraft[] @relation("IncomeDraftResolvedBy")

  @@unique([portalId, bitrixUserId])
  @@index([portalId])
  @@index([portalId, isActive])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id          String  @id @default(cuid())
  portalId    String
  portal      PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  clientName      String?
  internalComment String?

  status ProjectStatus @default(ACTIVE)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  sourceType      ProjectSource  @default(MANUAL)
  crmEntityType   CrmEntityType?
  crmEntityTypeId Int?
  crmEntityId     String?
  crmEntityTitle  String?
  crmEntityUrl    String?

  /// Пакет поддержки для раздела «Аналитика» (ADR-034): часов в календарный месяц,
  /// абонентская плата за месяц и ставка за час сверх пакета. null — не задано.
  supportHoursLimit Decimal? @db.Decimal(8, 2)
  supportMonthlyFee Decimal? @db.Decimal(18, 2)
  supportHourRate   Decimal? @db.Decimal(18, 2)

  createdById String?
  createdBy   AppUser? @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   AppUser? @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  archivedAt   DateTime?
  archivedById String?
  archivedBy   AppUser? @relation("ProjectArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ProjectMember[]
  entries FinancialEntry[]
  timeDrafts TaskTimeDraft[]
  incomeDrafts CrmIncomeDraft[]
  supportPostings SupportPosting[]
  streams         ProjectStream[]

  @@index([portalId])
  @@index([portalId, status])
  @@index([portalId, crmEntityTypeId, crmEntityId])
}

model ProjectMember {
  id        String  @id @default(cuid())
  portalId  String
  portal    PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      AppUser @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)

  addedById String?
  addedBy   AppUser? @relation("MemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([portalId])
  @@index([userId])
  @@index([projectId])
}

// ─── Categories (statute of income / expense) ────────────────────────────────

model FinanceCategory {
  id        String  @id @default(cuid())
  portalId  String
  portal    PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)

  kind       CategoryKind
  name       String
  /// Palette key (blue | violet | orange | green | graphite | burgundy | cyan).
  accentColor String @default("graphite")
  sortOrder  Int     @default(0)
  isArchived Boolean @default(false)
  /// Seeded starter categories (ТЗ §1). Cannot be renamed away from its role, still archivable.
  isSystem   Boolean @default(false)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries FinancialEntry[]

  @@unique([portalId, kind, name])
  @@index([portalId])
  @@index([portalId, kind, isArchived])
}

// ─── Financial entries (the core) ───────────────────────────────────────────

model FinancialEntry {
  id        String  @id @default(cuid())
  portalId  String
  portal    PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId String
  category   FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  direction       FinanceDirection
  budgetType      BudgetType
  calculationMode CalculationMode  @default(FIXED)

  operationDate DateTime @db.Date

  /// Authoritative amount. For HOURS_RATE the server sets amount = round2(hours * hourlyRate)
  /// and never trusts a client-supplied value.
  amount     Decimal  @db.Decimal(18, 2)
  hours      Decimal? @db.Decimal(10, 2)
  hourlyRate Decimal? @db.Decimal(10, 2)

  /// Исполнитель (a portal employee), optional.
  employeeId String?
  employee   AppUser? @relation("EntryEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  contractorName   String?
  counterpartyName String?
  invoiceNumber    String?
  invoiceDate      DateTime? @db.Date
  documentUrl      String?
  description      String?
  comment          String?

  /// Направление проекта (ADR-052): поддержка, внедрение, разработка… null — весь проект.
  streamId String?
  stream   ProjectStream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  /// Optional link from a FACT entry to the PLAN entry it realises (ТЗ §15).
  plannedEntryId String?
  plannedEntry   FinancialEntry?  @relation("PlanFact", fields: [plannedEntryId], references: [id], onDelete: SetNull)
  factEntries    FinancialEntry[] @relation("PlanFact")

  /// Set when this entry was created by approving a TaskTimeDraft (ADR-027).
  sourceTimeDraft TaskTimeDraft?
  /// Set when this entry was created/is kept in sync by approving a CrmIncomeDraft (ADR-028).
  sourceIncomeDraft CrmIncomeDraft?

  createdById String?
  createdBy   AppUser? @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   AppUser? @relation("EntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  /// Soft delete (ТЗ §31). Excluded from every aggregate; still visible in the audit log.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   AppUser? @relation("EntryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portalId])
  @@index([projectId])
  @@index([categoryId])
  @@index([portalId, operationDate])
  @@index([portalId, projectId, budgetType, direction, deletedAt])
  @@index([portalId, deletedAt])
  @@index([employeeId])
  @@index([createdById])
}

// ─── Audit log (ТЗ §30, §32) ────────────────────────────────────────────────

model AuditLog {
  id       String  @id @default(cuid())
  portalId String
  portal   PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)

  actorId   String?
  actor     AppUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot of the actor's display name at the time of the action.
  actorName String

  action     AuditAction
  entityType AuditEntityType
  entityId   String
  /// Denormalised for "history of project X" filtering.
  projectId  String?

  before        Json?
  after         Json?
  changedFields String[] @default([])

  createdAt DateTime @default(now())

  @@index([portalId, createdAt])
  @@index([portalId, entityType, entityId])
  @@index([portalId, projectId])
  @@index([portalId, actorId])
  @@index([portalId, action])
}

/// Log of server-side REST calls to a portal's Bitrix24 (requests + responses), kept for at
/// least 3 days as the Marketplace requires. `request`/`response` are token-redacted and
/// truncated. Rows older than API_LOG_RETENTION_DAYS are purged opportunistically.
model ApiCallLog {
  id         String   @id @default(cuid())
  portalId   String
  portal     PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  method     String
  request    String?
  response   String?
  ok         Boolean
  errorCode  String?
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([portalId, createdAt])
}

/// Which Bitrix24 CRM entity types the "import project from CRM" picker offers, beyond the
/// two always-available built-ins (Deal id 2, Company id 4). Lets a portal add its own Smart
/// Process (e.g. a custom leads/requests process) as a project source without any code
/// change — configured once by an admin in Settings, so ordinary users importing a project
/// never have to think about which CRM entity type their org uses (ADR-026).
model CrmImportSource {
  id           String   @id @default(cuid())
  portalId     String
  portal       PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  entityTypeId Int
  /// Snapshot of the type's title in Bitrix24 at the time it was added (crm.type.list) —
  /// shown in the import picker; not kept in sync if renamed on the Bitrix24 side.
  label        String
  createdAt    DateTime @default(now())

  @@unique([portalId, entityTypeId])
  @@index([portalId])
}

/// Where a CRM type keeps time spent on an item (ADR-040): e.g. «Заявки BK» has one field for
/// hours and one for minutes. Elements of that type linked to a project add this time to the
/// project's analytics on top of task time tracking.
model CrmTimeField {
  id           String   @id @default(cuid())
  portalId     String
  portal       PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  entityTypeId Int
  /// Snapshot of the type's title at save time, for the settings list.
  label        String
  hoursField   String?
  minutesField String?
  /// Field holding who did the work (type employee); null = the item's responsible.
  userField    String?
  updatedAt    DateTime @updatedAt

  @@unique([portalId, entityTypeId])
  @@index([portalId])
}

// ─── Автоматизация расходов по часам (ADR-027) ──────────────────────────────

enum TimeDraftStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Ночной синк агрегирует отработанные часы по задачам Битрикс24, привязанным к CRM-элементу
/// проекта, в черновик (не сразу в FinancialEntry — ТЗ §5: PLAN/FACT остаются единственными
/// "настоящими" строками). Менеджер подтверждает черновик -> создаётся FinancialEntry; либо
/// отклоняет -> черновик остаётся REJECTED, но следующий синк может снова предложить эту дату
/// заново (см. src/server/services/time-sync.ts), если по ней всё ещё числятся часы.
model TaskTimeDraft {
  id        String @id @default(cuid())
  portalId  String
  portal    PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   AppUser @relation("TimeDraftEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  workDate DateTime @db.Date
  hours    Decimal  @db.Decimal(10, 2)
  /// Bitrix24 task ids that contributed to this total, for traceability (not FK'd — external ids).
  bitrixTaskIds Int[]

  status TimeDraftStatus @default(PENDING)

  resultingEntryId String?          @unique
  resultingEntry   FinancialEntry?  @relation(fields: [resultingEntryId], references: [id], onDelete: SetNull)

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   AppUser? @relation("TimeDraftResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portalId, projectId, employeeId, workDate])
  @@index([portalId, status])
  @@index([projectId])
}

// ─── Автоматизация дохода из CRM (ADR-028) ──────────────────────────────────

/// Одна строка на проект (не накопительная, в отличие от TaskTimeDraft): отражает ТЕКУЩУЮ
/// сумму сделки/смарт-процесса в Битрикс24 (поле "opportunity"). Ночной синк перезаписывает
/// crmAmount и переоткрывает черновик (PENDING) при каждом изменении суммы в CRM — даже если
/// он уже был APPROVED/REJECTED, потому что старое решение относилось к другой сумме. Одобрение
/// создаёт/обновляет ОДНУ PLAN-строку дохода (resultingEntryId) — повторное одобрение при новой
/// сумме правит её же, а не плодит вторую.
model CrmIncomeDraft {
  id        String @id @default(cuid())
  portalId  String
  portal    PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  crmAmount Decimal  @db.Decimal(18, 2)
  syncedAt  DateTime @default(now())

  status TimeDraftStatus @default(PENDING)

  resultingEntryId String?         @unique
  resultingEntry   FinancialEntry? @relation(fields: [resultingEntryId], references: [id], onDelete: SetNull)

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   AppUser? @relation("IncomeDraftResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portalId, projectId])
  @@index([portalId, status])
}

// ─── Поддержка по часам → финансы (ADR-045) ─────────────────────────────────

/// One support month of a project written into finance: the income entry and the
/// per-specialist expense entries it created, and the totals at that moment (to show
/// «изменилось» when Bitrix24 hours move later). Re-posting replaces those entries.
model SupportPosting {
  id        String @id @default(cuid())
  portalId  String
  portal    PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 'YYYY-MM' in the analytics time zone.
  month String

  seconds       Int
  incomeAmount  Decimal @db.Decimal(18, 2)
  expenseAmount Decimal @db.Decimal(18, 2)
  /// FinancialEntry ids created by this posting (not FK'd: entries are soft-deleted, kept).
  entryIds String[]

  postedAt   DateTime @default(now())
  postedById String?

  @@unique([portalId, projectId, month])
}

// ─── Статистика продаж по воронкам (ADR-029) ────────────────────────────────

enum DealSemantic {
  IN_PROGRESS
  WON
  LOST
}

/// Ночной снепшот сделок портала, сгруппированных по воронке (Bitrix "категория" сделки) и
/// статусу — читается напрямую, ничего не пишет в финансы проекта (в отличие от
/// TaskTimeDraft/CrmIncomeDraft). Позволяет клиенту видеть "первичные продажи" и "абонентское
/// обслуживание" (разные воронки) раздельно, а не одной слитной суммой.
model SalesFunnelSnapshot {
  id           String @id @default(cuid())
  portalId     String
  portal       PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  categoryId   Int
  categoryName String
  semantic     DealSemantic
  dealCount    Int
  totalAmount  Decimal @db.Decimal(18, 2)
  syncedAt     DateTime @default(now())

  @@unique([portalId, categoryId, semantic])
  @@index([portalId])
}

/// What a CRM section is for on this portal (ADR-041): leads may be all incoming traffic,
/// deals first sales, a smart process client support.
enum CrmRole {
  TRAFFIC
  SALES
  SUPPORT
  PROJECTS
  IGNORE
}

model CrmSectionRole {
  id           String   @id @default(cuid())
  portalId     String
  portal       PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  entityTypeId Int
  /// Snapshot of the section's title at save time.
  label        String
  role         CrmRole
  updatedAt    DateTime @updatedAt

  @@unique([portalId, entityTypeId])
  @@index([portalId])
}

// ─── Marketing by channel (ADR-048) ────────────────────────────────────────

enum MarketingSpendKind {
  /// Budget actually spent (realised) — what CPL, CPL-2 and CAC are counted from.
  SPENT
  /// Money paid to the channel (account top-ups, invoices) — shown, never used in CPL/CAC.
  PAID
}

/// Money put into a marketing channel. The channel is a Bitrix24 source (SOURCE_ID).
model MarketingSpend {
  id        String             @id @default(cuid())
  portalId  String
  portal    PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  sourceId  String
  date      DateTime           @db.Date
  kind      MarketingSpendKind @default(SPENT)
  amount    Decimal            @db.Decimal(18, 2)
  note      String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  @@index([portalId, date])
}

/// Monthly plan, per channel or for all channels together (sourceId '').
model MarketingPlan {
  id             String             @id @default(cuid())
  portalId       String
  portal         PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  /// 'YYYY-MM' in the analytics time zone.
  month          String
  sourceId       String             @default("")
  budget         Decimal?           @db.Decimal(18, 2)
  leads          Int?
  qualifiedLeads Int?
  sales          Int?

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([portalId, month, sourceId])
}

/// Per-portal marketing settings: which traffic stages count as a qualified lead.
model MarketingConfig {
  portalId        String             @id
  portal          PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  qualifiedStages String[]
  updatedAt       DateTime           @updatedAt
}

/// How a CRM stage counts (ADR-051), when the portal's own stage semantics don't say it: a
/// smart-process stage can be "in progress" in Bitrix24 and still mean the work is over.
enum StageOutcome {
  PROCESS
  CLOSED
  SUCCESS
  CANCELLED
}

model CrmStageRule {
  id           String             @id @default(cuid())
  portalId     String
  portal       PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  entityTypeId Int
  /// Bitrix24 stage id (STATUS_ID), e.g. DT1044_55:NEW; unique only within a CRM type.
  stageId      String
  outcome      StageOutcome
  updatedAt    DateTime           @updatedAt

  @@unique([portalId, entityTypeId, stageId])
  @@index([portalId])
}

/// What kind of work a project direction is (ADR-052).
enum StreamKind {
  SUPPORT
  IMPLEMENTATION
  DEVELOPMENT
  CONSULTING
  OTHER
}

/// A direction of a project (ADR-052): one client project can be on support and in
/// development at once, paid separately and done by different teams.
model ProjectStream {
  id        String             @id @default(cuid())
  portalId  String
  portal    PortalInstallation @relation(fields: [portalId], references: [id], onDelete: Cascade)
  projectId String
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind   StreamKind
  /// Own name when the kind alone doesn't say it ("Мобильное приложение").
  name   String?
  status ProjectStatus @default(ACTIVE)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  /// How the direction is paid: a fixed budget, a monthly fee with a package of hours, an
  /// hour rate — any of them, all optional.
  budget     Decimal? @db.Decimal(18, 2)
  monthlyFee Decimal? @db.Decimal(18, 2)
  hourRate   Decimal? @db.Decimal(18, 2)
  hoursLimit Decimal? @db.Decimal(8, 2)

  /// AppUser ids of the direction's team; any portal employee, not only project members.
  memberIds String[]

  comment String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  entries FinancialEntry[]

  @@index([portalId])
  @@index([portalId, projectId])
  @@index([portalId, kind])
}
