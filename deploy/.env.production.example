# Production .env for `docker compose up -d` on the VPS.
# Copy to project root as `.env`. Never commit the filled-in version.

DATABASE_URL="postgresql://economics:economics@db:5432/economics?schema=public"
APP_URL="https://economics.example.com"
NODE_ENV="production"

SESSION_SECRET=""          # openssl rand -base64 48
APP_ENCRYPTION_KEY=""      # openssl rand -base64 32  (exactly 32 bytes)

B24_CLIENT_ID=""
B24_CLIENT_SECRET=""

DEMO_MODE="false"
